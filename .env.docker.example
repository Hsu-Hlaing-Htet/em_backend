APP_NAME="EM Backend"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

LOG_CHANNEL=stderr
LOG_LEVEL=info

# External database (e.g. Render Postgres) — no DB service in docker-compose
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require

# Set true on first deploy to run migrations, then false
RUN_MIGRATIONS=false

# Primary frontend origin (password-reset links, etc.)
FRONTEND_URL=http://localhost:5173

# Comma-separated exact browser origins allowed by CORS (no wildcards)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
CORS_SUPPORTS_CREDENTIALS=false

# Domains that may use Sanctum stateful/cookie auth (host[:port], no scheme)
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,localhost:5174,127.0.0.1,127.0.0.1:5173,127.0.0.1:5174

PORT=8000
