*.log
.DS_Store
# Local environment files; retain safe templates.
.env
.env.*
!.env.example
!.env.docker.example
/vendor
/node_modules
/storage/*.key
/public/storage
# Ignore runtime contents while preserving directory placeholders.
/storage/logs/*
!/storage/logs/.gitignore
/storage/framework/*
!/storage/framework/cache/
!/storage/framework/sessions/
!/storage/framework/views/
/bootstrap/cache/.test-verification

# Local verification runs create disposable databases, cached framework files,
# generated fixtures, and machine-specific test reports.
/.test-verification/

# Generated test result reports; retain authored testing documentation.
/docs/testing/*-results.xml
/docs/testing/coverage-audit.json
/docs/testing/unit-summary.json
/docs/testing/verification-results.json
