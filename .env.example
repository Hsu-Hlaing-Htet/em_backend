APP_NAME="Rosewood Royale"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_TIMEZONE=Asia/Yangon

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rosewood_royale
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Resend API transport. Never commit a real API key.
# MAIL_FROM_ADDRESS must use a sender/domain verified in Resend.
# Until a domain is verified, Resend only delivers to the account owner's email
# when using onboarding@resend.dev (other recipients return a 422 from this API).
MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS=onboarding@resend.dev
MAIL_FROM_NAME="${APP_NAME}"

# LOCAL TESTING ONLY. Never set true in production.
# When APP_ENV=local and this is true, Forgot Password emails any typed address
# so external delivery can be verified. Leave false for the secure reset flow.
PASSWORD_RESET_LOCAL_DELIVERY_TEST=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Optional absolute HTTPS URL for the logo in transactional email clients.
# Inline CID branding is used when the local logo asset is available.
# Example: https://your-domain.com/images/logo-dark.jpg
# Example (local tunnel): https://your-ngrok-url.ngrok-free.app/images/logo-dark.jpg
# Leave empty to use APP_URL or FRONTEND_URL when they are public HTTPS origins.
MAIL_LOGO_URL=

# Primary frontend origin (used for password-reset links, etc.)
FRONTEND_URL=http://localhost:5173

# ngrok example (replace placeholders with the URLs assigned to your tunnels):
# APP_URL=https://BACKEND_NGROK_URL
# FRONTEND_URL=https://FRONTEND_NGROK_URL

# Comma-separated exact browser origins allowed by CORS (no wildcards)
# Local: both Vite ports. Production: set to the exact deployed origin only.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# ngrok example:
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://FRONTEND_NGROK_URL

# Keep false with Bearer-token auth. Only enable if the SPA sends cookies.
CORS_SUPPORTS_CREDENTIALS=false

# Domains that may use Sanctum stateful/cookie auth (host[:port], no scheme)
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,localhost:5174,127.0.0.1,127.0.0.1:5173,127.0.0.1:5174

# Optional path to Chrome/Chromium for document PDF generation
# Local macOS default is used when unset. Render Docker sets /usr/bin/chromium.
# DOCUMENTS_CHROME_PATH="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
# CHROME_NO_SANDBOX=true

# FastAPI AI service (Laravel proxies these; the browser never calls AI directly)
# Production: https://rosewood-royale-ai.onrender.com (no trailing slash)
AI_SERVICE_BASE_URL=http://127.0.0.1:8001
AI_SERVICE_TIMEOUT_SECONDS=60
# Optional shared secret sent as X-Rosewood-AI-Internal-Key (must match AI_INTERNAL_KEY in ai/.env)
# AI_SERVICE_INTERNAL_KEY=
